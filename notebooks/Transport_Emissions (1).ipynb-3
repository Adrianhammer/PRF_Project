      "source": [
        "overview = pd.DataFrame()\n",
        "overview[\"Model\"] = [\"1 cars\", \"2 emissions\"]\n",
        "overview[\"Dependent variable\"] = [\"cars_per_1000\", \"emission_pc\"]\n",
        "overview[\"N\"] = [model_cars.nobs, model_emission.nobs]\n",
        "overview[\"R2\"] = [model_cars.rsquared, model_emission.rsquared]\n",
        "overview[\"adj R2\"] = [model_cars.rsquared_adj, model_emission.rsquared_adj]\n",
        "overview[\"F p-value\"] = [model_cars.f_pvalue, model_emission.f_pvalue]\n",
        "\n",
        "overview.round(4)"
      ]
    },
